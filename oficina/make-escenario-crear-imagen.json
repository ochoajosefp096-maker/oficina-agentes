              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": -150
                }
              }
            },
            {
              "id": 6,
              "module": "http:DownloadFile",
              "version": 4,
              "parameters": {
                "authenticationType": "noAuth"
              },
              "mapper": {
                "url": "{{first(flatten(map(7.data.data.result.images; \"url\")))}}",
                "shareCookies": false,
                "stopOnHttpError": true
              },
              "metadata": {
                "designer": {
                  "x": 2100,
                  "y": -150
                }
              }
            },
            {
              "id": 9,
              "module": "google-drive:uploadAFile",
              "version": 4,
              "parameters": {
                "__IMTCONN__": null
              },
              "mapper": {
                "data": "{{6.data}}",
                "select": "map",
                "convert": false,
                "filename": "{{ifempty(1.nombre; \"imagen\")}}.png",
                "folderId": "root"
              },
              "metadata": {
                "designer": {
                  "x": 2400,
                  "y": -150
                }
              }
            },
            {
              "id": 11,
              "module": "scenario-service:ReturnData",
              "version": 2,
