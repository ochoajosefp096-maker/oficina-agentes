{
  "name": "Crear imagen APIMart",
  "flow": [
    {
      "id": 1,
      "module": "scenario-service:StartSubscenario",
      "version": 2,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "interface": [
          {
            "name": "prompt",
            "type": "text",
            "label": "",
            "help": "",
            "default": "",
            "required": true,
            "multiline": true
          },
          {
            "name": "nombre",
            "type": "text",
            "label": "",
            "help": "",
            "default": "",
            "required": false,
            "multiline": false
          },
          {
            "name": "referencia_id",
            "type": "text",
            "label": "",
            "help": "ID en Google Drive de la imagen de referencia del protagonista (opcional)",
            "default": "",
            "required": false,
            "multiline": false
          },
          {
            "name": "formato",
            "type": "text",
            "label": "",
            "help": "Proporcion de la imagen, por ejemplo 1:1, 16:9 o 9:16 (opcional)",
            "default": "",
            "required": false,
            "multiline": false
          }
        ]
      }
    },
    {
      "id": 30,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 2,
              "module": "http:MakeRequest",
              "version": 4,
              "parameters": {
                "tlsType": "",
                "authenticationType": "noAuth"
              },
              "mapper": {
                "url": "https://api.apimart.ai/v1/images/generations",
                "method": "post",
                "headers": [
                  {
                    "name": "Authorization",
                    "value": "Bearer TU_CLAVE_APIMART"
                  },
                  {
                    "name": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "timeout": "40",
                "shareCookies": false,
                "parseResponse": true,
                "allowRedirects": true,
                "stopOnHttpError": true,
                "requestCompressedContent": true,
                "contentType": "json",
                "inputMethod": "jsonString",
                "jsonStringBodyContent": "{\"model\": \"gpt-image-2.5-ext\", \"prompt\": \"{{1.prompt}}\", \"size\": \"{{ifempty(1.formato; \"1:1\")}}\", \"resolution\": \"1K\", \"n\": 1}"
              },
              "metadata": {
                "designer": {
                  "x": 600,
                  "y": -150
                }
              },
              "filter": {
                "name": "Sin referencia",
                "conditions": [
                  [
                    {
                      "a": "{{1.referencia_id}}",
                      "o": "notexist"
                    }
                  ]
                ]
              }
            },
            {
              "id": 3,
              "module": "util:FunctionSleep",
              "version": 1,
              "parameters": {},
              "mapper": {
                "duration": "50"
              },
              "metadata": {
                "designer": {
                  "x": 900,
                  "y": -150
                }
              }
            },
            {
              "id": 4,
              "module": "http:MakeRequest",
              "version": 4,
              "parameters": {
                "tlsType": "",
                "authenticationType": "noAuth"
              },
              "mapper": {
                "url": "https://api.apimart.ai/v1/tasks/{{get(get(2.data.data; 1); \"task_id\")}}",
                "method": "get",
                "headers": [
                  {
                    "name": "Authorization",
                    "value": "Bearer TU_CLAVE_APIMART"
                  }
                ],
                "timeout": "40",
                "shareCookies": false,
                "parseResponse": true,
                "allowRedirects": true,
                "stopOnHttpError": true,
                "requestCompressedContent": true
              },
              "metadata": {
                "designer": {
                  "x": 1200,
                  "y": -150
                }
              }
            },
            {
              "id": 5,
              "module": "util:FunctionSleep",
              "version": 1,
              "parameters": {},
              "mapper": {
                "duration": "{{if(4.data.data.status = \"completed\"; 1; 100)}}"
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": -150
                }
              }
            },
            {
              "id": 7,
              "module": "http:MakeRequest",
              "version": 4,
              "parameters": {
                "tlsType": "",
                "authenticationType": "noAuth"
              },
              "mapper": {
                "url": "https://api.apimart.ai/v1/tasks/{{get(get(2.data.data; 1); \"task_id\")}}",
