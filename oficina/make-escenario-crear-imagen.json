                "allowRedirects": true,
                "stopOnHttpError": true,
                "requestCompressedContent": true,
                "contentType": "json",
                "inputMethod": "jsonString",
                "jsonStringBodyContent": "{\"model\": \"gpt-image-2.5-ext\", \"prompt\": \"{{1.prompt}}\", \"size\": \"{{ifempty(1.formato; \"1:1\")}}\", \"resolution\": \"1K\", \"n\": 1, \"image_urls\": [\"data:image/jpeg;base64,{{toString(20.data; \"base64\")}}\"]}"
              },
